<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="адрес сервиса"
            android:textSize="12sp" />

        <EditText
            android:id="@+id/server"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="https://voice-shell.onrender.com"
            android:inputType="textUri"
            android:autofillHints="url"
            android:importantForAutofill="no" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="токен доступа"
            android:textSize="12sp"
            android:layout_marginTop="12dp" />

        <EditText
            android:id="@+id/token"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="VOICE_TOKEN"
            android:inputType="textNoSuggestions"
            android:importantForAutofill="no" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="язык реплик — дальше меняется голосом"
            android:textSize="12sp"
            android:layout_marginTop="12dp" />

        <Spinner
            android:id="@+id/language"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <Button
            android:id="@+id/start"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="запустить" />

        <Button
            android:id="@+id/stop"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="остановить" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textSize="12sp"
            android:text="движок синтеза — RHVoice звучит живее системного" />

        <Spinner
            android:id="@+id/engine"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <Button
            android:id="@+id/engineList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="показать движки" />

        <Button
            android:id="@+id/engineUse"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="использовать выбранный" />

        <Button
            android:id="@+id/engineInstall"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="установить RHVoice" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textSize="12sp"
            android:text="голос синтеза" />

        <Spinner
            android:id="@+id/voice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <Button
            android:id="@+id/voiceList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="показать голоса" />

        <Button
            android:id="@+id/voiceTry"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="прослушать и выбрать" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textSize="12sp"
            android:text="сказать текстом — когда говорить нельзя" />

        <EditText
            android:id="@+id/say"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="скажи привет"
            android:inputType="textCapSentences"
            android:importantForAutofill="no" />

        <Button
            android:id="@+id/saySend"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="отправить" />

        <Button
            android:id="@+id/mute"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="озвучка: вкл" />

        <Button
            android:id="@+id/btmic"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="микрофон: гарнитура" />

        <Button
            android:id="@+id/battery"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="разрешить работу в фоне" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:textSize="12sp"
            android:text="подписка Claude на сервере" />

        <EditText
            android:id="@+id/authToken"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="sk-ant-oat01-… если токен уже есть"
            android:inputType="textNoSuggestions"
            android:importantForAutofill="no" />

        <Button
            android:id="@+id/authSave"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="сохранить токен Claude" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textSize="12sp"
            android:text="или пройти авторизацию заново:" />

        <Button
            android:id="@+id/authStart"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="подключить подписку" />

        <Button
            android:id="@+id/authOpen"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:enabled="false"
            android:text="открыть авторизацию" />

        <EditText
            android:id="@+id/authCode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:hint="вставь код со страницы"
            android:inputType="textNoSuggestions"
            android:importantForAutofill="no" />

        <Button
            android:id="@+id/authSend"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:text="готово" />

        <Button
            android:id="@+id/copyError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="скопировать последнюю ошибку" />

        <TextView
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:textSize="14sp"
            android:text="не запущено" />

        <TextView
            android:id="@+id/log"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textSize="12sp"
            android:fontFamily="monospace"
            android:textIsSelectable="true"
            android:text="" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:textSize="13sp"
            android:text="Язык меняется голосом: «Клод, английский», «Клод, иврит», «Клод, русский». Ответ произносится на том языке, на котором пришёл. Обращение «Клод» слышит сама трубка, без интернета. Дальше реплика распознаётся на выбранном языке — русский, английский или иврит. Скажи «Клод…» — распознавание обращения идёт на телефоне, наружу уходит только текст принятой реплики. Кнопка на наушниках разрешает сказать реплику без обращения. «Стоп» гасит голос, «останови работу» прерывает работу." />
    </LinearLayout>
</ScrollView>
