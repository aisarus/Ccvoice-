__pycache__/
*.pyc
.pytest_cache/
.venv/

# Рабочие копии агентов: это сам репозиторий, скопированный внутрь себя.
.claude/worktrees/

# Рабочее состояние демона: память, журнал точек отката, фоновые задачи.
# Лежит внутри рабочего каталога, а рабочим каталогом легко оказывается сам
# репозиторий — тогда без этой строки личные заметки уезжают в публичный push.
.voice-shell/

# Сборка Android: каталоги на сотни мегабайт и пути конкретной машины.
android/.gradle/
android/build/
android/app/build/
android/local.properties
*.apk
*.aab

# Секреты живут в /etc/voice-shell.env и в секретах GitHub, а не здесь.
.env
*.env
!.env.example

# Новые ключи подписи — мимо репозитория. Отладочный voice-shell.keystore
# уже в истории и намеренно открыт: чем он плох, написано в SECURITY.md.
*.keystore
*.jks
*.p12
!android/app/voice-shell.keystore
